{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/courses",
      "dest": "/api/courses.js"
    },
    {
      "src": "/api/subjects/([^/]+)",
      "dest": "/api/subjects/[id].js"
    },
    {
      "src": "/api/lessons/([^/]+)",
      "dest": "/api/lessons/[id].js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}