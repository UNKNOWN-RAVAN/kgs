{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/courses",
      "dest": "/api/courses.js"
    },
    {
      "src": "/api/subjects/([^/]+)",
      "dest": "/api/subjects/[id].js"
    },
    {
      "src": "/api/lessons/([^/]+)",
      "dest": "/api/lessons/[id].js"
    }
  ]
}
